<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cartier Orthodontics | Southampton & Wainscott, NY</title>
<meta name="description" content="Board Certified Orthodontist serving Southampton & Wainscott, NY. $500 off braces or Invisalign plus complimentary teeth whitening. Free consultation.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF6EC;
    --sand:#F2E8D4;
    --hairline:#E3D6B8;
    --ink:#10233A;
    --ink-2:#1C3B59;
    --ink-deep:#0A1729;
    --gold:#C9A15A;
    --gold-deep:#A97F3B;
    --gold-light:#EAD9AE;
    --blush:#C98B76;
    --blush-light:#F1D9CE;
    --text-soft:#5B6472;
    --white:#FFFFFF;
    --radius-sm:10px;
    --radius-md:20px;
    --radius-lg:32px;
    --shadow-navy:0 30px 60px -30px rgba(16,35,58,0.4);
    --shadow-card:0 14px 34px -20px rgba(16,35,58,0.3);
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
  }
  *,*::before,*::after{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;font-family:var(--font-body);background:var(--cream);color:var(--ink);line-height:1.65;-webkit-font-smoothing:antialiased;}
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  ul{margin:0;padding:0;list-style:none;}
  h1,h2,h3,h4{font-family:var(--font-display);margin:0;color:var(--ink);font-weight:600;}
  p{margin:0;}
  button{font-family:inherit;cursor:pointer;}
  section{position:relative;}
  .container{width:100%;max-width:1220px;margin:0 auto;padding:0 28px;}

  .eyebrow{display:inline-flex;align-items:center;gap:9px;font-size:0.76rem;letter-spacing:0.18em;text-transform:uppercase;font-weight:700;color:var(--gold-deep);margin-bottom:16px;}
  .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--gold);display:inline-block;}
  .section-head{max-width:660px;margin:0 auto 54px;text-align:center;}
  .section-head.left{margin:0 0 54px;text-align:left;}
  .section-head h2{font-size:clamp(2rem,3.6vw,2.9rem);line-height:1.14;margin-bottom:16px;letter-spacing:-0.01em;}
  .section-head p{color:var(--text-soft);font-size:1.05rem;}
  .arc-underline{display:block;width:64px;height:16px;margin:18px auto 0;}
  .section-head.left .arc-underline{margin:18px 0 0;}
  .arc-underline path{stroke:var(--gold);stroke-width:2.5;fill:none;stroke-linecap:round;}
  .on-dark h2, .on-dark .eyebrow{color:var(--white);}
  .on-dark .eyebrow{color:var(--gold-light);}
  .on-dark p{color:rgba(255,255,255,0.68);}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 32px;border-radius:999px;font-weight:600;font-size:0.97rem;border:1.5px solid transparent;transition:all .25s cubic-bezier(.2,.8,.3,1);white-space:nowrap;}
  .btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:var(--ink-deep);box-shadow:0 14px 28px -14px rgba(169,127,59,0.55);}
  .btn-gold:hover{transform:translateY(-3px);box-shadow:0 20px 36px -14px rgba(169,127,59,0.65);}
  .btn-outline-light{border-color:rgba(255,255,255,0.55);color:var(--white);}
  .btn-outline-light:hover{background:rgba(255,255,255,0.12);border-color:var(--white);}
  .btn-outline-dark{border-color:var(--ink);color:var(--ink);}
  .btn-outline-dark:hover{background:var(--ink);color:var(--white);}
  .btn-block{width:100%;}
  .btn svg{width:16px;height:16px;flex-shrink:0;}

  /* ===== Offer strip ===== */
  .offer-strip{background:var(--ink-deep);color:var(--gold-light);font-size:0.85rem;font-weight:600;text-align:center;padding:10px 16px;letter-spacing:0.02em;}
  .offer-strip span{color:var(--gold);}

  /* ===== Header ===== */
  header.site-header{background:rgba(16,35,58,0.97);backdrop-filter:blur(10px);position:sticky;top:0;z-index:100;box-shadow:0 6px 24px -18px rgba(0,0,0,0.6);}
  .nav-wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1220px;margin:0 auto;}
  .logo{display:flex;align-items:center;gap:11px;color:var(--white);}
  .logo .logo-mark{width:36px;height:36px;flex-shrink:0;}
  .logo-text{display:flex;flex-direction:column;line-height:1.1;}
  .logo-text strong{font-family:var(--font-display);font-size:1.22rem;letter-spacing:0.01em;}
  .logo-text small{font-size:0.68rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold-light);opacity:0.85;}
  .logo-img-wrap{position:relative;display:flex;align-items:center;height:42px;}
  .logo-img{height:42px;width:auto;max-width:190px;object-fit:contain;}
  .logo-fallback{display:none;align-items:center;gap:11px;}
  .header-actions{display:flex;align-items:center;gap:20px;}
  .header-phone{display:flex;flex-direction:column;font-size:0.76rem;color:rgba(255,255,255,0.65);line-height:1.3;}
  .header-phone a{color:var(--white);font-weight:700;font-size:0.92rem;}
  .header-phone a:hover{color:var(--gold-light);}

  /* ===== Hero ===== */
  .hero{background:radial-gradient(1100px 500px at 85% -10%, rgba(201,161,90,0.16), transparent 60%), radial-gradient(900px 500px at -10% 30%, rgba(28,59,89,0.10), transparent 55%), var(--cream);padding:90px 0 70px;overflow:hidden;}
  .hero-grid{display:grid;grid-template-columns:1.02fr 0.98fr;gap:60px;align-items:center;}
  .hero-copy{position:relative;}
  .hero-copy .bg-arc{position:absolute;top:-60px;left:-40px;width:340px;opacity:0.5;z-index:-1;}
  .hero-badge-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
  .hero-badge{display:flex;align-items:center;gap:8px;font-size:0.82rem;font-weight:600;color:var(--ink);background:var(--white);border:1px solid var(--hairline);padding:9px 16px;border-radius:999px;box-shadow:0 6px 16px -12px rgba(16,35,58,0.25);}
  .hero-badge svg{width:15px;height:15px;color:var(--gold-deep);flex-shrink:0;}
  .hero h1{font-size:clamp(2.3rem,4.3vw,3.5rem);line-height:1.1;letter-spacing:-0.015em;margin-bottom:22px;}
  .hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--gold-deep),var(--blush));-webkit-background-clip:text;background-clip:text;color:transparent;}
  .hero .lede{font-size:1.16rem;color:var(--text-soft);max-width:480px;margin-bottom:32px;}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-bottom:6px;}
  .hero-ctas .call-note{font-size:0.87rem;color:var(--text-soft);}
  .hero-ctas .call-note a{font-weight:700;color:var(--ink);border-bottom:1.5px solid var(--gold);}

  /* Right visual */
  .hero-visual{position:relative;display:flex;justify-content:center;}
  .hero-portrait{position:relative;width:100%;max-width:440px;aspect-ratio:4/4.6;border-radius:var(--radius-lg);background:linear-gradient(160deg,var(--ink) 0%, var(--ink-2) 55%, var(--gold-deep) 130%);overflow:hidden;box-shadow:var(--shadow-navy);}
  .hero-portrait svg.figure{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:78%;color:rgba(255,255,255,0.94);}
  .hero-portrait .real-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1;}
  .hero-portrait .grid-pattern{position:absolute;inset:0;opacity:0.15;}
  .hero-portrait .ring{position:absolute;border:1px solid rgba(234,217,174,0.35);border-radius:50%;}
  .hero-portrait .ring.r1{width:70%;padding-top:70%;top:6%;left:15%;}
  .float-card{position:absolute;background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);border-radius:16px;padding:14px 18px;box-shadow:0 18px 40px -18px rgba(16,35,58,0.4);display:flex;align-items:center;gap:11px;}
  .float-card .num{font-family:var(--font-display);font-size:1.3rem;color:var(--ink);font-weight:700;line-height:1;}
  .float-card .lbl{font-size:0.72rem;color:var(--text-soft);font-weight:600;}
  .float-card.fc-top{top:8%;left:-8%;}
  .float-card.fc-bottom{bottom:9%;right:-9%;}
  .float-card svg{width:26px;height:26px;color:var(--gold-deep);flex-shrink:0;}

  /* Appointment form */
  .form-wrap{margin-top:-30px;}
  .form-card{background:var(--white);border-radius:var(--radius-lg);padding:38px 34px 34px;box-shadow:var(--shadow-navy);border:1px solid var(--hairline);position:relative;}
  .form-card::before{content:"";position:absolute;top:0;left:32px;right:32px;height:3px;border-radius:0 0 4px 4px;background:linear-gradient(90deg,var(--gold),var(--blush));}
  .form-card h3{font-size:1.4rem;margin-bottom:4px;}
  .form-card .form-sub{color:var(--text-soft);font-size:0.92rem;margin-bottom:24px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .field{margin-bottom:15px;}
  .field label{display:block;font-size:0.78rem;font-weight:600;color:var(--text-soft);margin-bottom:6px;}
  .field input, .field textarea{width:100%;padding:13px 15px;border-radius:var(--radius-sm);border:1.5px solid var(--hairline);background:var(--cream);font-family:inherit;font-size:0.95rem;color:var(--ink);transition:border-color .2s, box-shadow .2s;}
  .field input:focus, .field textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,161,90,0.2);}
  .field textarea{resize:vertical;min-height:70px;}
  .consent{display:flex;gap:10px;align-items:flex-start;font-size:0.78rem;color:var(--text-soft);margin:16px 0 22px;}
  .consent input{margin-top:3px;flex-shrink:0;}
  .consent a{color:var(--gold-deep);font-weight:600;text-decoration:underline;}
  .form-success{display:none;text-align:center;padding:34px 6px;}
  .form-success.show{display:block;}
  .form-success svg{width:46px;height:46px;color:var(--gold-deep);margin:0 auto 16px;}
  .form-success h4{margin-bottom:6px;}
  .form-success p{color:var(--text-soft);font-size:0.92rem;}

  /* ===== Divider ===== */
  .divider{position:absolute;left:0;right:0;line-height:0;z-index:2;pointer-events:none;}
  .divider svg{width:100%;height:80px;display:block;}
  .divider.top{top:-1px;}

  /* ===== Embrace ===== */
  .embrace{background:var(--ink);padding:110px 0 104px;position:relative;overflow:hidden;}
  .embrace::before{content:"";position:absolute;width:640px;height:640px;border-radius:50%;border:1px solid rgba(234,217,174,0.08);top:-320px;left:-220px;}
  .embrace::after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(201,161,90,0.15),transparent 70%);bottom:-200px;right:-140px;}
  .embrace-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-bottom:46px;position:relative;}
  .embrace-item{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-md);padding:28px 24px;display:flex;gap:16px;align-items:flex-start;transition:background .25s, transform .25s;}
  .embrace-item:hover{background:rgba(255,255,255,0.09);transform:translateY(-4px);}
  .embrace-item .icon-wrap{width:44px;height:44px;flex-shrink:0;border-radius:12px;background:linear-gradient(135deg,var(--gold),var(--gold-deep));display:flex;align-items:center;justify-content:center;}
  .embrace-item .icon-wrap svg{width:21px;height:21px;color:var(--ink-deep);}
  .embrace-item h4{font-size:1.03rem;font-family:var(--font-body);font-weight:700;color:var(--white);margin-bottom:5px;}
  .embrace-item p{font-size:0.87rem;color:rgba(255,255,255,0.62);}
  .embrace-cta{text-align:center;position:relative;}

  /* ===== Treatments ===== */
  .treatments{padding:112px 0 104px;}
  .treatment-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
  .treatment-card{border-radius:var(--radius-md);padding:2px;background:linear-gradient(160deg,var(--hairline),var(--cream));transition:transform .3s, box-shadow .3s;}
  .treatment-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-card);}
  .treatment-card .inner{background:var(--white);border-radius:calc(var(--radius-md) - 2px);padding:30px 24px 28px;height:100%;}
  .treatment-card .icon-wrap{width:52px;height:52px;border-radius:15px;background:linear-gradient(150deg,var(--ink),var(--ink-2));display:flex;align-items:center;justify-content:center;margin-bottom:20px;}
  .treatment-card .icon-wrap svg{width:25px;height:25px;color:var(--gold-light);}
  .treatment-card h3{font-size:1.14rem;margin-bottom:11px;}
  .treatment-card p{font-size:0.88rem;color:var(--text-soft);}
  .treatment-card.featured{background:linear-gradient(160deg,var(--gold),var(--blush));}
  .treatment-card.featured .inner{background:linear-gradient(165deg,var(--ink) 0%, var(--ink-2) 100%);}
  .treatment-card.featured .icon-wrap{background:linear-gradient(135deg,var(--gold),var(--gold-deep));}
  .treatment-card.featured .icon-wrap svg{color:var(--ink-deep);}
  .treatment-card.featured h3,.treatment-card.featured p{color:var(--white);}
  .treatment-card.featured p{color:rgba(255,255,255,0.72);}

  /* ===== Concerns ===== */
  .concerns{background:var(--sand);padding:106px 0;}
  .concerns-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  .concern-card{background:var(--white);border-radius:var(--radius-md);padding:30px 28px;box-shadow:var(--shadow-card);border-left:4px solid var(--gold);}
  .concern-card:nth-child(2){border-left-color:var(--blush);}
  .concern-card:nth-child(3){border-left-color:var(--ink-2);}
  .concern-card:nth-child(4){border-left-color:var(--gold-deep);}
  .concern-card h3{font-family:var(--font-body);font-size:1.04rem;font-weight:700;color:var(--ink);margin-bottom:11px;display:flex;gap:11px;align-items:flex-start;}
  .concern-card h3 svg{width:21px;height:21px;color:var(--gold-deep);flex-shrink:0;margin-top:2px;}
  .concern-card h3 img.concern-icon{width:26px;height:26px;object-fit:contain;flex-shrink:0;margin-top:0;}
  .concern-card p{font-size:0.9rem;color:var(--text-soft);padding-left:32px;}

  /* ===== Doctor ===== */
  .doctor{padding:112px 0 104px;}
  .doctor-grid{display:grid;grid-template-columns:0.82fr 1.18fr;gap:60px;align-items:center;}
  .doctor-photo{position:relative;aspect-ratio:4/5;border-radius:var(--radius-lg);background:linear-gradient(165deg,var(--ink) 0%, var(--ink-2) 60%, var(--blush) 150%);overflow:hidden;display:flex;align-items:flex-end;justify-content:center;box-shadow:var(--shadow-navy);}
  .doctor-photo svg.figure{width:70%;color:rgba(255,255,255,0.95);margin-bottom:-4%;}
  .doctor-photo .real-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1;}
  .doctor-photo .dots{position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,0.12) 1px, transparent 1px);background-size:18px 18px;opacity:0.5;}
  .doctor-badge-float{position:absolute;bottom:18px;left:18px;right:18px;background:rgba(10,23,41,0.6);backdrop-filter:blur(8px);border:1px solid rgba(234,217,174,0.3);border-radius:14px;padding:13px 16px;color:var(--white);font-size:0.83rem;display:flex;align-items:center;gap:9px;}
  .doctor-badge-float svg{width:17px;height:17px;color:var(--gold);}
  .doctor-content .eyebrow{margin-bottom:12px;}
  .doctor-content h2{font-size:clamp(2rem,3.2vw,2.6rem);margin-bottom:20px;}
  .doctor-content p.bio{color:var(--text-soft);margin-bottom:28px;font-size:1.02rem;}
  .credential-list{display:flex;flex-wrap:wrap;gap:11px;margin-bottom:32px;}
  .credential-pill{display:flex;align-items:center;gap:8px;border:1.5px solid var(--hairline);background:var(--white);border-radius:999px;padding:9px 17px;font-size:0.83rem;font-weight:600;color:var(--ink);}
  .credential-pill svg{width:15px;height:15px;color:var(--gold-deep);}

  /* ===== Banner ===== */
  .banner{background:linear-gradient(150deg,var(--ink) 0%, var(--ink-2) 100%);padding:88px 0;text-align:center;position:relative;overflow:hidden;}
  .banner::before{content:"";position:absolute;width:2px;height:60px;background:var(--gold);left:50%;top:20px;transform:translateX(-50%);}
  .banner::after{content:"";position:absolute;width:560px;height:560px;border-radius:50%;border:1px solid rgba(234,217,174,0.13);top:-280px;right:-160px;}
  .banner h2{color:var(--white);font-size:clamp(1.8rem,3vw,2.4rem);margin-bottom:18px;max-width:680px;margin-left:auto;margin-right:auto;}
  .banner p{color:rgba(255,255,255,0.72);max-width:640px;margin:0 auto 32px;font-size:1.04rem;}

  /* ===== Testimonials ===== */
  .testimonials{padding:112px 0 104px;}
  .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .testi-card{background:var(--white);border:1px solid var(--hairline);border-radius:var(--radius-md);padding:32px 28px 28px;display:flex;flex-direction:column;position:relative;box-shadow:var(--shadow-card);}
  .testi-card .quote-mark{font-family:var(--font-display);font-size:3.2rem;color:var(--gold-light);line-height:1;margin-bottom:6px;}
  .testi-stars{display:flex;gap:3px;margin-bottom:14px;color:var(--gold);font-size:0.9rem;}
  .testi-card p.quote{font-size:0.91rem;color:var(--text-soft);flex-grow:1;margin-bottom:20px;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;}
  .testi-name{font-weight:700;color:var(--ink);font-size:0.92rem;display:flex;align-items:center;gap:10px;}
  .testi-name .avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--blush));flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--white);font-weight:700;font-size:0.78rem;font-family:var(--font-display);overflow:hidden;}
  .testi-name .avatar img{width:100%;height:100%;object-fit:cover;}

  /* ===== Before/After ===== */
  .transformations{background:var(--sand);padding:106px 0;}
  .transform-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .transform-card{background:var(--white);border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow-card);}
  .transform-visual{display:grid;grid-template-columns:1fr 1fr;height:190px;position:relative;}
  .transform-visual .half{display:flex;align-items:center;justify-content:center;position:relative;font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;}
  .transform-visual .half.before{background:linear-gradient(160deg,#E7DCC3,#D8C9A6);color:#8A7141;}
  .transform-visual .half.after{background:linear-gradient(160deg,var(--ink),var(--ink-2));color:var(--gold-light);}
  .transform-visual .half span{position:absolute;top:14px;left:16px;}
  .transform-visual .half svg{width:36px;height:36px;opacity:0.6;}
  .transform-visual .handle{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:34px;height:34px;border-radius:50%;background:var(--white);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px -8px rgba(0,0,0,0.4);z-index:2;}
  .transform-visual .handle svg{width:16px;height:16px;color:var(--ink);opacity:1;}
  .transform-visual img.real-transform{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:3;}
  .transform-caption{padding:19px 22px;display:flex;align-items:center;justify-content:space-between;}
  .transform-caption strong{font-size:0.93rem;color:var(--ink);}
  .transform-caption span{font-size:0.78rem;color:var(--text-soft);}

  /* ===== FAQ ===== */
  .faq{padding:112px 0 104px;}
  .faq-list{max-width:820px;margin:0 auto;}
  .faq-item{border-bottom:1.5px solid var(--hairline);}
  .faq-question{width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;padding:24px 4px;text-align:left;font-family:var(--font-display);font-size:1.08rem;color:var(--ink);font-weight:600;}
  .faq-question .plusminus{width:28px;height:28px;flex-shrink:0;border-radius:50%;background:var(--sand);position:relative;}
  .faq-question .plusminus::before,.faq-question .plusminus::after{content:"";position:absolute;background:var(--gold-deep);top:50%;left:50%;transform:translate(-50%,-50%);}
  .faq-question .plusminus::before{width:12px;height:1.8px;}
  .faq-question .plusminus::after{width:1.8px;height:12px;transition:transform .25s;}
  .faq-item.open .plusminus{background:var(--gold);}
  .faq-item.open .plusminus::before, .faq-item.open .plusminus::after{background:var(--ink-deep);}
  .faq-item.open .plusminus::after{transform:translate(-50%,-50%) rotate(90deg) scaleX(0);}
  .faq-answer{max-height:0;overflow:hidden;transition:max-height .35s ease;}
